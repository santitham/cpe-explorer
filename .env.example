# Copy this file to .env and edit.
# Port the game is served on.
PORT=8080
# Secret for admin commands (list / delete / reset scores). Leave empty to disable admin.
ADMIN_KEY=change-me-to-a-long-random-string
# Set to true when running behind a reverse proxy (nginx, Caddy, university gateway)
# so rate limiting uses the visitor's real IP from X-Forwarded-For.
TRUST_PROXY=false
# Keep at most this many scoreboard entries (lowest scores are dropped).
MAX_ENTRIES=5000
# Base image. If Docker Hub says "429 Too Many Requests", use the Google mirror:
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
